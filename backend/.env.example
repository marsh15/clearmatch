# Copy to .env and fill in — never commit the real .env.
# The app runs WITHOUT this key (deterministic fallback extractor, decisions
# capped at NEEDS REVIEW); set it to enable the real LLM extraction path.
OPENAI_API_KEY=sk-...

# Optional: protects POST /api/seed/reset when set (send via X-Reset-Token header)
# RESET_TOKEN=change-me

# Production only (Render provides DATABASE_URL automatically; Postgres)
# DATABASE_URL=postgresql://...
